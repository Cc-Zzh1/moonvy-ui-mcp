# 在已登录 Moonvy 的页面控制台执行：
# copy(window.app?.api?.$options?.token)
# 然后只把 token 保存到本机 .env，不要提交到 Git。
MOONVY_TOKEN=

# 可选配置
MOONVY_API_BASE=https://global-api.moonvy.com/v2
MOONVY_CACHE_TTL_MS=300000
MOONVY_MAX_GENOME_BYTES=52428800

# CSS 单位：auto 会将宽度不超过 750px 的移动端画板按 750rpx 基准换算
MOONVY_CSS_UNIT=auto
MOONVY_RPX_BASE_WIDTH=750
# 如需固定比例可设置，例如 1px = 2rpx；留空则按画板宽度自动计算
MOONVY_RPX_SCALE=
